{
  "name": "fullstack-project",
  "version": "1.0.0",
  "description": "A unified FullStack Next.js and Express.js project",
  "private": true,
  "main": "server/server.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:server\"",
    "dev:frontend": "next dev",
    "dev:server": "nodemon server/server.js",
    "build": "next build --webpack",
    "start": "next start && node server/server.js",
    "start:frontend": "next start",
    "start:server": "node server/server.js",
    "lint": "next lint"
  },
  "dependencies": {
    "@googlemaps/google-maps-services-js": "^3.4.0",
    "@react-google-maps/api": "^2.20.5",
    "axios": "^1.7.9",
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "i18next": "^25.7.4",
    "lucide-react": "^0.545.0",
    "mongoose": "^8.8.4",
    "next": "^16.1.1",
    "next-intl": "^4.7.0",
    "react": "^18.3.1",
    "react-datepicker": "^7.5.0",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.5.3",
    "react-icons": "^5.5.0",
    "react-loader-spinner": "^6.1.6",
    "sib-api-v3-sdk": "^8.5.0",
    "square": "^44.0.0",
    "stripe": "^17.5.0",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-datepicker": "^6.2.0",
    "@types/react-dom": "^19",
    "concurrently": "^8.2.0",
    "eslint": "^9",
    "eslint-config-next": "15.1.0",
    "nodemon": "^3.1.7",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  }
}
